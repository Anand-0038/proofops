# KeeperHub Incident Keeper — environment template
# Copy to .env and fill in. NEVER commit real secrets.

# Required for KeeperHub REST + MCP (headless)
KEEPERHUB_API_KEY=kh_YOUR_API_KEY_HERE
KEEPERHUB_API_URL=https://app.keeperhub.com
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Sepolia testnet RPC (public or Alchemy/Infura)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
NETWORK=sepolia

# Org wallet address (Turnkey via KeeperHub — for balance checks only)
WALLET_ADDRESS=0xYOUR_ORG_WALLET_HERE

# Optional: Blockscout MCP / explorer for read layer
BLOCKSCOUT_MCP_URL=https://mcp.blockscout.com/mcp
BLOCKSCOUT_API_URL=https://eth-sepolia.blockscout.com/api

# Target mock oracle / incident contract (deploy via Foundry, then set)
TARGET_CONTRACT_ADDRESS=
TARGET_ORACLE_ADDRESS=
ACTION_LOG_ADDRESS=

# Policy / agent
AGENT_VERSION=0.1.0
POLICY_VERSION=0.1.0
WORKFLOW_ID=
WORKFLOW_VERSION=1

# Evidence store
EVIDENCE_STORE_PATH=./data/evidence.jsonl
APPROVAL_QUEUE_PATH=./data/approvals.jsonl

# Drift thresholds (optional overrides — defaults in docs/architecture.md)
# DRIFT_ORACLE_STALE_LOW_SEC=3600
# DRIFT_ORACLE_STALE_MEDIUM_SEC=7200
# DRIFT_ORACLE_STALE_HIGH_SEC=21600
# DRIFT_HF_MEDIUM_BPS=12000
# DRIFT_HF_HIGH_BPS=11000
# POLICY_COOLDOWN_SEC=60

# Failure injection (scripts/inject-failure.ts)
INJECT_FAILURE_MODE=
# gas_spike | transient_rpc | unsafe_call | none

# Demo server
PORT=3847
# Leave empty for a generated local token in .proofops-operator-token.
PROOFOPS_OPERATOR_TOKEN=
# Comma-separated when the public dashboard origin differs from the server.
PROOFOPS_ALLOWED_ORIGIN=

# Strict submission gate (public HTTPS URLs, set only after publishing)
PUBLIC_REPOSITORY_URL=
DEMO_VIDEO_URL=
PUBLIC_DEMO_URL=

# x402 (optional — see docs/keeperhub.md)
X402_ENABLED=false
X402_PRICE_USDC=0.10
